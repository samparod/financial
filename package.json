{
  "name": "lmofid-cod",
  "version": "1.0.0",
  "description": "Istiqrar COD — local desktop app",
  "author": "Samparo",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "bot": "node bot/poll.mjs",
    "dev": "next dev -p 3070",
    "dev:local": "cross-env NEXT_PUBLIC_LOCAL_ONLY=1 next dev -p 3070",
    "dev:memory": "cross-env STATE_MEMORY=1 NEXT_PUBLIC_MEMORY_SERVER=1 next dev -p 3070",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.mjs\"",
    "build": "next build",
    "start": "next start -p 3070",
    "desktop": "node scripts/desktop-build.cjs && electron .",
    "desktop:dev": "concurrently -k \"cross-env NEXT_PUBLIC_ELECTRON=1 NEXT_PUBLIC_LOCAL_ONLY=1 next dev -p 3070\" \"wait-on http://127.0.0.1:3070 && cross-env ELECTRON_DEV=1 electron .\"",
    "desktop:pack": "node scripts/desktop-build.cjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "pro.samparo.istiqrar",
    "productName": "Istiqrar COD",
    "directories": {
      "output": "dist-desktop"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      }
    ],
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false,
      "artifactName": "Istiqrar-COD-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Istiqrar COD"
    }
  }
}
