PORT=3000
HOSTNAME=0.0.0.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_IDS=
TELEGRAM_WEBHOOK_SECRET=
# After setting TELEGRAM_WEBHOOK_SECRET, call GET /api/telegram?key=THE_SECRET once to register the webhook.
WEBAPP_URL=https://samparo.pro
WEBHOOK_URL=https://samparo.pro
# Set to 1 for browser-only: no /api/state, data in localStorage.
NEXT_PUBLIC_LOCAL_ONLY=
# Local PC: STATE_MEMORY=1 + NEXT_PUBLIC_MEMORY_SERVER=1 (see npm run dev:memory)
STATE_MEMORY=
NEXT_PUBLIC_MEMORY_SERVER=
# EasyPanel / self-host Postgres. Do not commit real credentials.
DATABASE_URL=postgres://postgres:PASSWORD@financial_financial:5432/financial?sslmode=disable
# On Netlify, Database injects NETLIFY_DB_URL automatically. Do not set or commit it.
# NETLIFY_DB_URL=
API_URL=http://127.0.0.1:3070
